DATABASE_URL=postgresql://user:pass@localhost:5432/n8n_docs
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=dummy
LMSTUDIO_TIMEOUT_SECONDS=30
LLM_MODEL=local-model
EMBEDDING_MODEL=text-embedding-3-small
DOCS_SOURCE_FILTER=n8n-docs
TOP_K=10
MAX_CONTEXT_CHARS=8000
LOG_LEVEL=INFO
APP_ENV=dev
# Optional override (true/false). By default: dev/qa show references, prod hides them.
APP_SHOW_REFERENCES=
# n8n API (local)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=15
N8N_WORKFLOW_ENDPOINT_TEMPLATE=/api/v1/workflows/{workflow_id}
# Workflow-aware limits
WORKFLOW_SUMMARY_MAX_NODES=200
WORKFLOW_MICRO_MAX_CHARS=1200
WORKFLOW_NEIGHBOR_DEPTH=1
WORKFLOW_MAX_NODES_NODE_SPECIFIC=6
WORKFLOW_MAX_NODES_SUBGRAPH=12
WORKFLOW_MAX_NODES_GLOBAL=15
WORKFLOW_DOCS_CANDIDATE_K=16
WORKFLOW_DOCS_TOP_K=8
MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES=20
MEMORY_TTL_SECONDS=3600
MEMORY_HEADER=x-conversation-id
MEMORY_AUTO_CREATE_CONVERSATION_ID=false
MEMORY_SKIP_PREFIXES=### Task
MEMORY_SKIP_ASSISTANT_JSON_KEYS=follow_ups,title,tags
MEMORY_DEDUP_WINDOW_SECONDS=8
MEMORY_BACKEND=postgres
MEMORY_CONVERSATIONS_TABLE=chat_conversations
MEMORY_MESSAGES_TABLE=chat_messages
TABLE_NAME=docs
TEXT_COLUMN=content
EMBEDDING_COLUMN=embedding
# Optional JSON mapping (example: metadata_docs.url)
METADATA_COLUMN=
URL_JSON_PATH=
TITLE_JSON_PATH=
SECTION_JSON_PATH=
SOURCE_JSON_PATH=
DISTANCE_OP=<=>
