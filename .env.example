ROUTER_USE_LLM=false
MAX_NODE_CARDS=10
MAX_DOC_CHUNKS=6
MAX_CONTEXT_TOKENS=2500
PM_MAX_STAGE_RETRIEVAL_PASSES=3
PM_MAX_USER_CLARIFICATIONS=2
PM_FIT_SCORE_THRESHOLD=0.70
PM_RERANK_THRESHOLD=0.55
PM_TOP_MARGIN_THRESHOLD=0.10
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2.5-gemma2-lightweight
RERANK_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL_SIZE=30
RERANK_TOP_K=8
RERANK_MAX_CHARS=2000
RERANK_USE_FP16=true
RERANK_BATCH_SIZE=
RERANK_DEVICE=
RERANK_CUTOFF_LAYERS=
RERANK_COMPRESS_LAYERS=
RERANK_COMPRESS_RATIO=
RETRIEVAL_DEBUG=false
LINKED_DEFS_ENABLED=true
LINKED_DEFS_TOP_DOCS=6
LINKED_DEFS_NODES_SOURCE=n8n-nodes
LINKED_DEFS_CREDENTIALS_SOURCE=n8n-credentials
LINKED_DEFS_MAX_NODE_DEFS=12
LINKED_DEFS_MAX_CREDENTIAL_DEFS=12
ENABLE_HYBRID=false
HYBRID_STRICT_MODE=false
N_VEC=50
N_FTS=50
FTS_LANGUAGE=simple
FTS_TSVECTOR_COLUMN=content_tsv
FTS_QUERY_MAX_CHARS=320
FTS_KEYWORDS_MAX_TERMS=14
FTS_KEYWORDS_MIN_TERM_LEN=3
FTS_ENABLE_RELAXED_FALLBACK=true
RRF_K=60
RRF_TOP_M=30
RRF_VECTOR_WEIGHT=1.0
RRF_FTS_WEIGHT=0.6
LOG_LEVEL=INFO
TRACE_LOG_ENABLED=false
TRACE_LOG_LEVEL=INFO
TRACE_MAX_TEXT_CHARS=4000
TRACE_MAX_CHUNK_CHARS=320
TRACE_MAX_CHUNKS=12
TRACE_LOG_FILE=logs/trace.log
TRACE_LOG_MAX_BYTES=5000000
TRACE_LOG_BACKUPS=3
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=n8n-local-assistant
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
APP_ENV=dev
