LMSTUDIO_API_KEY=dummy
LMSTUDIO_TIMEOUT_SECONDS=180
LLM_MODEL=mistralai/ministral-3-14b-reasoning
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
DOCS_SOURCE_FILTER=n8n-docs
TOP_K=10
MAX_CONTEXT_CHARS=8000
REASONING_PIPELINE_ENABLED=false
AGENT_RUNTIME=langgraph
LANGGRAPH_REASONING_ENABLED=true
LANGGRAPH_WORKFLOW_ENABLED=true
LANGGRAPH_EMERGENCY_LEGACY_FALLBACK=false
