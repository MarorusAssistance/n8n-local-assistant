fidence=n/a | blended_confidence=0.66 | usage_mode=unknown | usable_as_tool=False | has_main_input=unknown\n- n8n-nodes-base.sendInBlueTrigger | display=Brevo Trigger | evidence_confidence=0.66 | rerank_confidence=n/a | blended_confidence=0.66 | usage_mode=unknown | usable_as_tool=False | has_main_input=unknown\n- n8n-nodes-base.aiTransform | display=AI Transform | evidence_confidence=0.63 | rerank_confidence=n/a | blended_confidence=0.63 | usage_mode=action_only | usable_as_tool=False | has_main_input=True\n- n8n-nodes-base.Brandfetch | display=Brandfetch | evidence_confidence=0.63 | rerank_confidence=n/a | blended_confidence=0.63 | usage_mode=both | usable_as_tool=True | has_main_input=True\n- n8n-nodes-base.code | display=Code | evidence_confidence=0.63 | rerank_confidence=n/a | blended_confidence=0.63 | usage_mode=action_only | usable_as_tool=False | has_main_input=True\n- n8n-nodes-base.executionData | display=Execution Data | evidence_confidence=0.62 | rerank_confidence=n/a | blended_confidence=0.62 | usage_mode=action_only | usable_as_tool=False | has_main_input=True\n\nReturn structured output only.", "role": "user"}], "model": "mistralai/ministral-3-14b-reasoning", "params": {"temperature": 0.1}, "request_id": "414b4c3b20", "stage": "multi_agent.product_manager.structured", "total_chars": 2902, "ts_utc": "2026-03-10T11:39:36.680046+00:00"}
