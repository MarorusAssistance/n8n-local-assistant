ls: [] | usage_mode=action_only\n- n8n-nodes-base.Brandfetch | capability=Display Name: Brandfetch | limitations=Required Credentials: [\"brandfetchApi\"]; Documentation URLs: [\"https://docs.n8n.io/integrations/builtin/app-nodes/n8n-nodes-base.brandfetch/\", \"https://docs.n8n.io/integrations/builtin/credentials/brandfetch/\"] | usage_mode=both\n- n8n-nodes-base.code | capability=Group: [\"transform\"] | limitations=Required Credentials: [] | usage_mode=action_only\n- @n8n/n8n-nodes-langchain.toolWorkflow | capability=Description: Uses another n8n workflow as a tool. | limitations=Required Credentials: [] | usage_mode=unknown\n- n8n-nodes-base.executionData | capability=Display Name: Execution Data | limitations=Required Credentials: [] | usage_mode=action_only\n- n8n-nodes-base.googleSheets | capability=Description: Read, update and write data to Google Sheets | limitations=Required Credentials: [\"googleApi\", \"googleSheetsOAuth2Api\"]; Documentation URLs: [\"https://docs.n8n.io/integrations/builtin/app-nodes/n8n-nodes-base.googlesheets/\", \"https://docs.n8n.io/integrations/builtin/credentials/google/oauth-single... | usage_mode=action_only", "role": "user"}], "model": "mistralai/ministral-3-14b-reasoning", "params": {"structured": true, "temperature": 0.1}, "request_id": "7769704b1d", "stage": "multi_agent.product_manager.stage_candidate_summary", "total_chars": 2887, "ts_utc": "2026-03-10T19:58:06.673623+00:00"}
