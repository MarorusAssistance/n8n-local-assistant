tials/activecampaign/\"] | usage_mode=both\n- n8n-nodes-base.code | capability=Group: [\"transform\"] | limitations=Required Credentials: [] | usage_mode=action_only\n- n8n-nodes-base.executionData | capability=Display Name: Execution Data | limitations=Required Credentials: [] | usage_mode=action_only\n- @n8n/n8n-nodes-langchain.ollama | capability=Group: [\"transform\"] | limitations=Required Credentials: [\"ollamaApi\"] | usage_mode=unknown\n- @n8n/n8n-nodes-langchain.vectorStoreQdrant | capability=Group: [\"transform\"] | limitations=Required Credentials: [\"qdrantApi\"] | usage_mode=unknown", "role": "user"}], "model": "mistralai/ministral-3-14b-reasoning", "params": {"structured": true, "temperature": 0.1}, "request_id": "7769704b1d", "stage": "multi_agent.product_manager.stage_candidate_summary", "total_chars": 2330, "ts_utc": "2026-03-10T19:58:54.953182+00:00"}
