n8n.io/integrations/builtin/app-nodes/n8n-nodes-base.gmail/label-operations"}, {"content": "Email Trigger (IMAP) node / Operations Receive an email", "context_kind": "", "doc_id": "(723,6)", "linked_def_type": "", "linked_entity_id": "", "rerank_score": null, "rrf_score": 0.014084507042253521, "section": "Email Trigger (IMAP) node / Operations", "snippet": "Email Trigger (IMAP) node / Operations Receive an email", "source": "", "title": "Email Trigger (IMAP) node", "url": "https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.emailimap"}, {"content": "Self-hosted AI Starter Kit / What you can build ⭐️ AI Agents{ data-preview} that can schedule appointments ⭐️ Summaries of company PDFs without leaking data ⭐️ Smarter Slackbots for company communications and IT-ops ⭐...", "context_kind": "", "doc_id": "(295,4)", "linked_def_type": "", "linked_entity_id": "", "rerank_score": null, "rrf_score": 0.013888888888888888, "section": "Self-hosted AI Starter Kit / What you can build", "snippet": "Self-hosted AI Starter Kit / What you can build ⭐️ AI Agents{ data-preview} that can schedule appointments ⭐️ Summaries of company PDFs without leaking data ⭐️ Smarter Slackbots for company communications and IT-ops ⭐...", "source": "", "title": "Self-hosted AI Starter Kit", "url": "https://docs.n8n.io/hosting/starter-kits/ai-starter-kit"}], "query_chars": 1353, "request_id": "6497d73a09", "rerank_enabled": true, "results_count": 8, "source_filter": "n8n-docs", "stage": "rag.retrieve_context", "top_k": 8, "ts_utc": "2026-03-17T20:42:21.663522+00:00"}
